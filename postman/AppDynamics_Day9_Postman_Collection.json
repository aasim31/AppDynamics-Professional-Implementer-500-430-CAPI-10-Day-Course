{
  "info": {
    "_postman_id": "aecab783-94f7-44ab-aedd-5e7b49fe31ca",
    "name": "AppDynamics Day 9 - Controller APIs",
    "description": "All Day 9 lab requests (plus the Day 7 Machine Agent listener). Select the 'AppDynamics Lab' environment, run 'Get OAuth token' first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1 Authentication",
      "item": [
        {
          "name": "Get OAuth token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/controller/api/oauth/access_token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "controller",
                "api",
                "oauth",
                "access_token"
              ]
            },
            "description": "Tests tab saves the token: pm.environment.set(\"token\", pm.response.json().access_token). Token lasts 5 min by default.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{clientName}}@{{account}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{clientSecret}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.environment.set(\"token\", j.access_token);",
                  "pm.test(\"token received\", () => pm.expect(j.access_token).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "List applications (Basic auth)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/controller/rest/applications?output=JSON",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "controller",
                "rest",
                "applications"
              ],
              "query": [
                {
                  "key": "output",
                  "value": "JSON"
                }
              ]
            },
            "description": "Authorization tab \u2192 Basic Auth: Username {{user}}@{{account}}, Password {{password}}.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{user}}@{{account}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
