              "raw": "{{baseUrl}}/controller/rest/applications/{{app}}/metric-data?metric-path=Overall Application Performance|Average Response Time (ms)&time-range-type=BEFORE_NOW&duration-in-mins=60&rollup=false&output=JSON",
